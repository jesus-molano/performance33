# Copia este archivo como .env.local con los MISMOS valores públicos que la web de monitores
# (VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY de su .env.local o de Vercel).
# Sin ellas, la app arranca en "Demo sin conexión" con datos inventados.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICA
# Opcional: dirección pública de esta app (para el enlace de privacidad). Por defecto la de Vercel.
# EXPO_PUBLIC_APP_URL=https://performance33-socios.vercel.app
