# Copia este archivo como .env.local y rellénalo con los datos de tu proyecto de Supabase.
# Sin estas dos variables, en tu ordenador la app arranca en "Modo local de pruebas".
# Una web publicada sin ellas no arranca, salvo que añadas VITE_ALLOW_LOCAL_DEMO=true (demo con las cuentas de prueba a la vista).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICA
